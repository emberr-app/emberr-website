---
import IconTile from './IconTile.astro';
import type { HighlightColorName, IconName } from './icons';

type FeatureGroup = 'Write' | 'Plan' | 'Private';

interface Feature {
	group: FeatureGroup;
	title: string;
	description: string;
	icon: IconName;
	color: HighlightColorName;
}

const features: Feature[] = [
	{
		group: 'Write',
		title: 'Block editor',
		description:
			'Build notes from more than 20 blocks: checklists, tables, databases, canvases, logins with a password generator, a movie and show watchlist, and more. Attach images, documents and voice notes, or start from a template.',
		icon: 'blocks',
		color: 'purple'
	},
	{
		group: 'Plan',
		title: 'Daily notes and calendar',
		description:
			'Every day gets its own page for your thoughts and tasks. A built-in calendar with reminders, color categories, and all-day and repeating events you can drag to move or resize.',
		icon: 'calendar',
		color: 'orange'
	},
	{
		group: 'Private',
		title: 'Sync on your terms',
		description:
			'Sync your phone and desktop over your own network, encrypted and signed even on public Wi-Fi. Or self-host on your own WebDAV server, encrypted on your device before upload.',
		icon: 'sync',
		color: 'blue'
	},
	{
		group: 'Write',
		title: 'Make it yours',
		description:
			"13 color themes, or your wallpaper's colors on Android, plus paper texture, interface scale from 80% to 200% and 18 languages. Split view on desktop with up to 4 notes side by side. 11 home screen widgets and App Lock on Android.",
		icon: 'themes',
		color: 'pink'
	},
	{
		group: 'Plan',
		title: 'Spaces and people',
		description:
			'Keep work, personal and school apart in separate spaces. Keep track of people, their details and the tasks you assign them, imported from your phone or a .vcf file.',
		icon: 'people',
		color: 'green'
	},
	{
		group: 'Private',
		title: 'AI only if you want it',
		description:
			'AI is off by default. Turn it on to chat with your notes using a local model on your device, or your own OpenAI, Anthropic or Gemini key.',
		icon: 'sparkle',
		color: 'yellow'
	}
];
---

<section id="features" class="page-width features" aria-labelledby="features-title">
	<div class="features-intro">
		<h2 id="features-title" class="section-heading">
			<span class="heading-strong">Everything in one place.</span>
			<span class="heading-soft">Fully offline.</span>
		</h2>
		<p class="features-summary">Write, plan and keep it private, all in one app.</p>
	</div>
	<ul class="feature-grid">
		{
			features.map((feature) => (
				<li class="feature-tile">
					<div class="feature-tile-top">
						<IconTile icon={feature.icon} color={feature.color} />
						<p class="eyebrow">{feature.group}</p>
					</div>
					<h3 class="feature-title">{feature.title}</h3>
					<p class="feature-description">{feature.description}</p>
				</li>
			))
		}
	</ul>
	<p class="features-import">
		<IconTile icon="import" color="lime" size="small" />
		<span>Bring your notes with you: import from Markdown and Obsidian, and export to Markdown or PDF at any time.</span>
	</p>
</section>

<style>
	.features {
		padding-block: 80px;
		border-top: 1px solid var(--color-border);
	}

	.features-intro {
		display: grid;
		gap: 20px;
	}

	.features-summary {
		max-width: 30rem;
		color: var(--color-text-secondary);
	}

	.feature-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 16px;
		margin: 48px 0 0;
		padding: 0;
		list-style: none;
	}

	.feature-tile {
		display: flex;
		flex-direction: column;
		min-height: 240px;
		padding: 24px;
		border: 1px solid var(--color-border);
		border-radius: 24px;
		background-color: var(--color-card);
	}

	.feature-tile-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
	}

	.feature-tile .eyebrow {
		color: var(--color-text-secondary);
	}

	.feature-title {
		margin-top: auto;
		padding-top: 40px;
		font-family: var(--font-sans);
		font-size: 1.5rem;
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.002em;
	}

	.feature-description {
		margin-top: 12px;
		color: var(--color-text-secondary);
		font-size: 1.0625rem;
	}

	.features-import {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-top: 32px;
		color: var(--color-text-secondary);
	}

	@media (min-width: 640px) {
		.feature-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 960px) {
		.features {
			padding-block: 120px;
		}

		.features-intro {
			grid-template-columns: 1.2fr 0.8fr;
			align-items: end;
			gap: 76px;
		}

		.feature-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			margin-top: 64px;
		}

		.feature-tile {
			min-height: 300px;
			padding: 32px;
		}

		.feature-description {
			font-size: 1.125rem;
		}
	}
</style>

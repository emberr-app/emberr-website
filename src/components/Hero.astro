---
import ButtonLink from './ButtonLink.astro';
---

<section class="hero" aria-labelledby="hero-title">
	<div class="page-width hero-content">
		<p class="pill hero-badge rise-in" style="animation-delay: 0.05s">Beta · Free and open source</p>
		<h1 id="hero-title" class="hero-title rise-in" style="animation-delay: 0.16s">
			<span class="heading-strong">Emberr</span>
			<span class="heading-soft">Private Workspace</span>
		</h1>
		<p class="hero-summary rise-in" style="animation-delay: 0.3s">
			Notes, tasks, a calendar and reminders in one app. Your data stays on your device unless you choose
			otherwise.
		</p>
		<div class="hero-actions rise-in" style="animation-delay: 0.44s">
			<ButtonLink href="#download">Download</ButtonLink>
			<ButtonLink href="https://github.com/emberr-app/Emberr">View on GitHub</ButtonLink>
		</div>
		<p class="hero-platforms rise-in" style="animation-delay: 0.58s">Android · Linux · Windows</p>
	</div>
</section>

<style>
	.hero {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: max(640px, 100svh);
		padding-block: 96px 40px;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		height: 36px;
		margin-bottom: 36px;
		padding-inline: 16px;
		border-radius: 9999px;
		color: var(--color-text-muted);
		font-size: 0.8125rem;
	}

	.hero-title {
		font-size: clamp(2.5rem, 10vw, 3rem);
		line-height: 1.02;
		letter-spacing: -0.035em;
	}

	.hero-summary {
		max-width: 30rem;
		margin-top: 28px;
		color: var(--color-text-muted);
		line-height: 1.65;
		text-wrap: pretty;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: 40px;
	}

	.hero-platforms {
		margin-top: 24px;
		color: color-mix(in srgb, var(--color-text) 80%, transparent);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		text-shadow:
			0 0 3px var(--color-background),
			0 0 8px var(--color-background),
			0 0 14px var(--color-background);
	}

	@media (min-width: 640px) {
		.hero-title {
			font-size: clamp(3rem, 5.6vw, 4.75rem);
		}

		.hero-summary {
			font-size: 1.0625rem;
		}
	}
</style>

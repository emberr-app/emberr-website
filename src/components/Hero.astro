---
import ArrowIcon from './ArrowIcon.astro';
import ButtonLink from './ButtonLink.astro';
import TextLink from './TextLink.astro';
---

<section class="page-width hero" aria-labelledby="hero-title">
	<div class="hero-intro">
		<h1 id="hero-title" class="hero-title">Emberr:<br />Private<br />Workspace</h1>
		<p class="hero-summary">
			Write notes, plan your days and keep your reminders in one app for Android, Linux and Windows. It’s
			free, open source, and your data stays on your device unless you choose otherwise.
		</p>
		<div class="hero-actions">
			<ButtonLink href="#download">Download Emberr</ButtonLink>
			<TextLink href="#features" arrow="down">Look around</TextLink>
		</div>
		<p class="hero-release">
			Beta for Android, Linux and Windows<span class="hero-release-separator" aria-hidden="true"> · </span><a
				href="https://github.com/emberr-app/Emberr/releases/latest">Release notes</a
			>
		</p>
	</div>

	<div class="hero-cards">
		<article class="hero-card hero-card-notes">
			<a class="card-link" href="#notes">
				<span class="card-number" aria-hidden="true">01</span>
				<h2 class="card-title">Notes</h2>
				<span class="card-arrow"><ArrowIcon direction="down" /></span>
			</a>
			<p class="card-summary">Write it down,<br />block by block.</p>
			<div class="note-mock" aria-hidden="true">
				<span class="note-mock-title">A note for later.</span>
				<p>Type / to add a checklist, a table or a canvas.</p>
				<span class="note-mock-highlight">/checklist</span><span class="note-mock-caret"></span>
			</div>
		</article>

		<article class="hero-card hero-card-today">
			<a class="card-link" href="#today">
				<span class="card-number" aria-hidden="true">02</span>
				<h2 class="card-title">Today</h2>
				<span class="card-arrow"><ArrowIcon direction="down" /></span>
			</a>
			<p class="card-summary">Every day gets<br />a page of its own.</p>
			<div class="today-mock" aria-hidden="true">
				<div class="today-mock-page">
					<span class="today-mock-title">Today</span>
					<span class="today-mock-chips"><span>1 Pending</span><span>1 Done</span></span>
					<span class="today-mock-task today-mock-task-done"><span class="today-mock-box">✓</span>Water the plants</span>
					<span class="today-mock-task"><span class="today-mock-box"></span>Call the dentist</span>
				</div>
			</div>
		</article>

		<article class="hero-card hero-card-sync">
			<a class="card-link" href="#sync">
				<span class="card-number" aria-hidden="true">03</span>
				<h2 class="card-title">Sync</h2>
				<span class="card-arrow"><ArrowIcon direction="down" /></span>
			</a>
			<p class="card-summary">Your devices,<br />your network.</p>
			<svg class="sync-mock" viewBox="0 0 240 160" fill="none" aria-hidden="true">
				<rect x="24" y="40" width="52" height="96" rx="10" class="sync-mock-paper" stroke="currentColor" stroke-width="1.5"></rect>
				<path d="M34 58h26M34 68h32M34 78h20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
				<rect x="118" y="34" width="104" height="68" rx="6" class="sync-mock-paper" stroke="currentColor" stroke-width="1.5"></rect>
				<rect x="124" y="40" width="24" height="56" rx="3" fill="currentColor" opacity="0.12"></rect>
				<path d="M156 50h40M156 60h54M156 70h32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
				<path d="M106 110h128l-8 8H114z" class="sync-mock-paper" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
				<path d="M78 92c18 32 30 28 40 0" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 4" stroke-linecap="round"></path>
				<circle cx="101" cy="114" r="14" fill="currentColor"></circle>
				<rect x="94" y="112" width="14" height="10" rx="2" class="sync-mock-paper"></rect>
				<path d="M97 112v-3a4 4 0 0 1 8 0v3" class="sync-mock-paper-line" stroke-width="1.5"></path>
			</svg>
		</article>
	</div>
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: 40px;
		padding-block: 44px 56px;
	}

	.hero-title {
		font-size: clamp(3rem, 12vw, 4.5rem);
		line-height: 1.04;
		letter-spacing: -0.045em;
	}

	.hero-summary {
		max-width: 380px;
		margin: 24px 0;
		color: var(--color-text-muted);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 20px;
	}

	.hero-release {
		margin-top: 20px;
		color: var(--color-text-muted);
		font-size: 0.8125rem;
	}

	.hero-release a {
		display: table;
		margin-top: 4px;
		text-decoration-color: var(--color-border);
		text-underline-offset: 3px;
	}

	.hero-release a:hover {
		color: var(--color-text);
		text-decoration-color: currentColor;
	}

	.hero-release-separator {
		display: none;
	}

	.hero-cards {
		display: grid;
		grid-template-columns: 1fr;
		gap: 16px;
		min-width: 0;
	}

	.hero-card {
		position: relative;
		display: flex;
		flex-direction: column;
		min-width: 0;
		height: 240px;
		padding: 24px;
		overflow: hidden;
		border-radius: 18px;
		color: var(--color-on-pastel);
	}

	.hero-card-notes {
		background-color: var(--color-pastel-lilac);
	}

	.hero-card-today {
		background-color: var(--color-pastel-yellow);
	}

	.hero-card-sync {
		background-color: var(--color-pastel-peach);
	}

	.card-link {
		position: relative;
		display: block;
		width: 100%;
		padding-bottom: 12px;
		text-decoration: none;
	}

	.card-number {
		display: block;
		margin-bottom: 24px;
		font-size: 0.75rem;
	}

	.card-title {
		font-size: 1.7rem;
		letter-spacing: -0.045em;
		line-height: 1.1;
	}

	.card-arrow {
		position: absolute;
		top: 0;
		right: 0;
		display: flex;
		transition: transform 200ms ease;
	}

	.card-link:hover .card-arrow {
		transform: translateY(4px);
	}

	.card-summary {
		width: 50%;
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.note-mock {
		position: absolute;
		top: 84px;
		right: -14px;
		width: 44%;
		height: 200px;
		padding: 16px 12px;
		border: 1px solid var(--color-on-pastel);
		border-radius: 8px 8px 0 0;
		background-color: var(--color-mock-paper);
		box-shadow: 5px 0 0 rgba(120, 100, 190, 0.35);
		transform: rotate(-8deg);
		transition: transform 300ms ease;
	}

	.note-mock-title {
		display: block;
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.25;
		letter-spacing: -0.03em;
	}

	.note-mock p {
		margin: 10px 0;
		color: var(--color-on-pastel-muted);
		font-size: 0.75rem;
		line-height: 1.6;
	}

	.note-mock-highlight {
		padding: 1px 4px;
		border-radius: 4px;
		background-color: var(--color-pastel-lilac);
		font-size: 0.75rem;
	}

	.note-mock-caret {
		display: inline-block;
		width: 1px;
		height: 1rem;
		margin-left: 4px;
		vertical-align: middle;
		background-color: var(--color-on-pastel);
	}

	.today-mock {
		position: absolute;
		top: 64px;
		right: 12px;
		width: 44%;
		height: 158px;
	}

	.today-mock::before {
		content: '';
		position: absolute;
		inset: 12px 1px 0;
		border: 1px solid rgba(38, 34, 36, 0.45);
		border-radius: 12px;
		background-color: var(--color-pastel-yellow-deep);
		transform: rotate(8deg);
	}

	.today-mock-page {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
		height: 100%;
		padding: 14px 12px;
		border: 1px solid var(--color-on-pastel);
		border-radius: 12px;
		background-color: var(--color-mock-paper);
		transform: rotate(-5deg);
		transition: transform 280ms ease;
	}

	.today-mock-title {
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: -0.03em;
	}

	.today-mock-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
	}

	.today-mock-chips span {
		padding: 2px 6px;
		border: 1px solid rgba(38, 34, 36, 0.25);
		border-radius: 6px;
		font-size: 0.625rem;
		font-weight: 500;
		white-space: nowrap;
	}

	.today-mock-task {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 0.6875rem;
		line-height: 1.3;
	}

	.today-mock-task-done {
		color: var(--color-on-pastel-muted);
		text-decoration: line-through;
	}

	.today-mock-box {
		display: inline-grid;
		place-items: center;
		flex-shrink: 0;
		width: 12px;
		height: 12px;
		border: 1px solid var(--color-on-pastel);
		border-radius: 3px;
		font-size: 0.5rem;
		line-height: 1;
	}

	.today-mock-task-done .today-mock-box {
		background-color: var(--color-on-pastel);
		color: var(--color-mock-paper);
	}

	.sync-mock {
		position: absolute;
		right: 0;
		bottom: 8px;
		width: 50%;
		height: auto;
		color: var(--color-on-pastel);
	}

	.sync-mock-paper {
		fill: var(--color-mock-paper);
	}

	.sync-mock-paper-line {
		stroke: var(--color-mock-paper);
	}

	@media (hover: hover) and (prefers-reduced-motion: no-preference) {
		.hero-card-notes:hover .note-mock {
			transform: rotate(-5deg) translateY(-3px);
		}

		.hero-card-today:hover .today-mock-page {
			transform: rotate(0deg) translateY(-4px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card-arrow,
		.note-mock,
		.today-mock-page {
			transition: none;
		}
	}

	@media (min-width: 640px) {
		.hero {
			gap: 48px;
			padding-block: 56px 80px;
		}

		.hero-intro {
			display: grid;
			grid-template-columns: 1fr 1fr;
			align-items: center;
			column-gap: 48px;
		}

		.hero-title {
			grid-row: span 3;
			font-size: clamp(3rem, 6.7vw, 4.5rem);
		}

		.hero-summary {
			align-self: end;
			margin: 0 0 24px;
		}

		.hero-actions {
			align-self: start;
		}

		.hero-release {
			grid-column: 2;
			align-self: start;
			margin-top: 16px;
		}

		.hero-cards {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 14px;
		}

		.hero-card {
			height: 385px;
			padding: 24px 20px 0;
		}

		.card-number {
			margin-bottom: 32px;
		}

		.card-summary {
			width: auto;
		}

		.note-mock,
		.today-mock,
		.sync-mock {
			position: relative;
			top: auto;
			right: auto;
			bottom: auto;
			align-self: center;
			width: 100%;
			max-width: 210px;
			margin-top: auto;
		}

		.note-mock {
			height: 194px;
			transform: rotate(-5deg) translateY(9px);
		}

		.today-mock {
			height: 186px;
			margin-bottom: 16px;
		}

		.sync-mock {
			margin-bottom: 16px;
		}

		@media (hover: hover) and (prefers-reduced-motion: no-preference) {
			.hero-card-notes:hover .note-mock {
				transform: rotate(-2deg) translateY(3px);
			}
		}
	}

	@media (min-width: 1100px) {
		.hero {
			grid-template-columns: minmax(300px, 0.94fr) minmax(0, 1.7fr);
			align-items: center;
			gap: clamp(32px, 4vw, 80px);
			padding-block: clamp(64px, 6vw, 112px) 96px;
		}

		.hero-intro {
			display: block;
		}

		.hero-title {
			font-size: clamp(3.3rem, 4.9vw, 5.3rem);
		}

		.hero-summary {
			margin: 28px 0 32px;
			font-size: 1.0625rem;
		}

		.hero-release {
			margin-top: 24px;
		}

		.hero-release-separator {
			display: inline;
		}

		.hero-release a {
			display: inline;
			margin-top: 0;
		}

		.hero-card {
			height: 445px;
		}

		.card-number {
			margin-bottom: 44px;
		}

		.card-title {
			font-size: clamp(1.4rem, 1.85vw, 2rem);
		}

		.note-mock {
			height: 215px;
		}

		.today-mock {
			height: 216px;
		}
	}
</style>

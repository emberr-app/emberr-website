---
import ButtonLink from './ButtonLink.astro';
import IconTile from './IconTile.astro';
import type { HighlightColorName, IconName } from './icons';
import TextLink from './TextLink.astro';
import { siteLinks } from '../siteLinks';

interface HeroHighlight {
	label: string;
	icon: IconName;
	color: HighlightColorName;
}

const heroHighlights: HeroHighlight[] = [
	{ label: 'Notes', icon: 'notes', color: 'purple' },
	{ label: 'Tasks', icon: 'checkbox', color: 'green' },
	{ label: 'Calendar', icon: 'calendar', color: 'orange' },
	{ label: 'Reminders', icon: 'bell', color: 'yellow' }
];
---

<section class="page-width hero" aria-labelledby="hero-title">
	<div class="hero-heading-column">
		<p class="eyebrow hero-badge rise-in" style="animation-delay: 0.05s">Beta · Free and open source</p>
		<h1 id="hero-title" class="hero-title rise-in" style="animation-delay: 0.16s">
			<span class="heading-strong">Emberr</span>
			<span class="heading-soft" data-typing-line>Private Workspace</span>
		</h1>
		<ul class="hero-highlights rise-in" style="animation-delay: 0.24s">
			{
				heroHighlights.map((highlight) => (
					<li class="hero-highlight">
						<IconTile icon={highlight.icon} color={highlight.color} size="small" />
						<span>{highlight.label}</span>
					</li>
				))
			}
		</ul>
	</div>
	<div class="hero-body-column rise-in" style="animation-delay: 0.3s">
		<p class="hero-summary">
			Notes, tasks, a calendar and reminders in one app. It works offline, needs no account and keeps your data
			on your device.
		</p>
		<div class="hero-actions">
			<ButtonLink href="#download" variant="accent">Download</ButtonLink>
			<TextLink href={siteLinks.github}>View on GitHub</TextLink>
		</div>
		<p class="hero-platforms">Android · Linux · Windows</p>
	</div>
</section>

<script>
	const typingStartDelayInMilliseconds = 700;
	const delayBetweenLettersInMilliseconds = 75;

	function startTyping(typingLine: HTMLElement) {
		const letters = Array.from(typingLine.textContent ?? '').map((character) => {
			const letter = document.createElement('span');
			letter.className = 'typed-letter';
			letter.textContent = character;
			return letter;
		});
		const cursor = document.createElement('span');
		cursor.className = 'typing-cursor';
		cursor.setAttribute('aria-hidden', 'true');
		typingLine.replaceChildren(cursor, ...letters);

		let typedLetterCount = 0;

		function typeNextLetter() {
			const letter = letters[typedLetterCount];
			letter.classList.add('typed-letter-shown');
			letter.after(cursor);
			typedLetterCount += 1;
			if (typedLetterCount < letters.length) {
				window.setTimeout(typeNextLetter, delayBetweenLettersInMilliseconds);
			} else {
				cursor.classList.add('typing-cursor-blinking');
			}
		}

		window.setTimeout(typeNextLetter, typingStartDelayInMilliseconds);
	}

	const typingLine = document.querySelector<HTMLElement>('[data-typing-line]');
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (typingLine && !prefersReducedMotion) startTyping(typingLine);
</script>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: 32px;
		padding-block: 64px 48px;
	}

	.hero-badge {
		margin-bottom: 24px;
		color: var(--color-text-secondary);
	}

	.hero-title {
		font-family: var(--font-sans);
		font-size: clamp(2.75rem, 11vw, 3.8125rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.002em;
	}

	.hero-title :global(.typed-letter) {
		opacity: 0;
	}

	.hero-title :global(.typed-letter-shown) {
		opacity: 1;
	}

	.hero-title :global(.typing-cursor) {
		display: inline-block;
		width: 3px;
		height: 0.9em;
		margin-inline: 2px -5px;
		border-radius: 1px;
		background-color: var(--color-text);
		vertical-align: -0.1em;
	}

	.hero-title :global(.typing-cursor-blinking) {
		animation: cursor-blink 1.1s step-end infinite;
	}

	@keyframes cursor-blink {
		50% {
			opacity: 0;
		}
	}

	.hero-highlights {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 24px;
		margin: 32px 0 0;
		padding: 0;
		list-style: none;
	}

	.hero-highlight {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		font-weight: 500;
		letter-spacing: -0.005em;
	}

	.hero-summary {
		max-width: 30rem;
		text-wrap: pretty;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 24px;
		margin-top: 32px;
	}

	.hero-platforms {
		margin-top: 24px;
		color: var(--color-text-secondary);
		font-family: var(--font-sans);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
	}

	@media (min-width: 960px) {
		.hero {
			grid-template-columns: 1.2fr 0.8fr;
			align-items: end;
			gap: 76px;
			padding-block: 120px 76px;
		}
	}
</style>

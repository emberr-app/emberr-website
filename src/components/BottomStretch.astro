<div class="bottom-stretch" data-bottom-stretch aria-hidden="true">
	<svg class="stretch-stripes" viewBox="0 0 1440 200" preserveAspectRatio="none">
		<path class="stripe-mint" d="M0 0H1440V200H0Z"></path>
		<path class="stripe-blue" d="M0 44C300 30 620 56 940 40C1140 30 1320 46 1440 40V200H0Z"></path>
		<path class="stripe-yellow" d="M0 84C260 92 560 72 880 86C1120 96 1300 78 1440 84V200H0Z"></path>
		<path class="stripe-pink" d="M0 124C340 116 640 134 980 122C1180 114 1340 128 1440 122V200H0Z"></path>
		<path class="stripe-orange" d="M0 162C280 170 600 152 900 166C1140 176 1320 158 1440 164V200H0Z"></path>
	</svg>
</div>

<script>
	const maximumStretch = 220;
	const pullResistance = 0.6;
	const releaseDelayInMilliseconds = 220;
	const followStiffness = 0.12;
	const followDamping = 0.7;
	const releaseStiffness = 0.05;
	const releaseDamping = 0.86;
	const pixelsPerWheelLine = 16;

	function startBottomStretch(stretchLayer: HTMLElement) {
		const movingParts = Array.from(document.querySelectorAll<HTMLElement>('main, footer'));
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

		let rawPull = 0;
		let targetStretch = 0;
		let stretch = 0;
		let velocity = 0;
		let isPulling = false;
		let releaseTimer = 0;
		let springFrameId = 0;
		let touchStartY: number | null = null;

		function isAtBottom(): boolean {
			return window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
		}

		function stretchFromPull(pull: number): number {
			return maximumStretch * (1 - 1 / (1 + (pull * pullResistance) / maximumStretch));
		}

		function applyStretch() {
			const isMoving = Math.abs(stretch) > 0.5;
			for (const part of movingParts) {
				part.style.transform = isMoving ? `translate3d(0, ${-stretch}px, 0)` : '';
				part.style.willChange = isMoving ? 'transform' : '';
			}
			stretchLayer.style.height = `${Math.max(0, stretch)}px`;
		}

		function springStep() {
			const stiffness = isPulling ? followStiffness : releaseStiffness;
			const damping = isPulling ? followDamping : releaseDamping;
			velocity = (velocity + (targetStretch - stretch) * stiffness) * damping;
			stretch += velocity;

			const settled = Math.abs(targetStretch - stretch) < 0.2 && Math.abs(velocity) < 0.2;
			if (settled) {
				stretch = targetStretch;
				velocity = 0;
				applyStretch();
				springFrameId = 0;
				return;
			}

			applyStretch();
			springFrameId = requestAnimationFrame(springStep);
		}

		function keepSpringRunning() {
			if (springFrameId === 0) springFrameId = requestAnimationFrame(springStep);
		}

		function moveTowards(newTargetStretch: number) {
			targetStretch = newTargetStretch;
			if (reducedMotion.matches) {
				stretch = targetStretch;
				velocity = 0;
				applyStretch();
				return;
			}
			keepSpringRunning();
		}

		function release() {
			isPulling = false;
			rawPull = 0;
			moveTowards(0);
		}

		window.addEventListener(
			'wheel',
			(event) => {
				const wheelPixels = event.deltaMode === 1 ? event.deltaY * pixelsPerWheelLine : event.deltaY;
				if (!isAtBottom() || (wheelPixels <= 0 && rawPull === 0)) return;
				isPulling = true;
				rawPull = Math.max(0, rawPull + wheelPixels);
				moveTowards(stretchFromPull(rawPull));
				window.clearTimeout(releaseTimer);
				releaseTimer = window.setTimeout(release, releaseDelayInMilliseconds);
			},
			{ passive: true }
		);

		window.addEventListener(
			'touchstart',
			(event) => {
				touchStartY = isAtBottom() ? event.touches[0].clientY : null;
			},
			{ passive: true }
		);

		window.addEventListener(
			'touchmove',
			(event) => {
				if (touchStartY === null) return;
				const pulledUp = touchStartY - event.touches[0].clientY;
				if (pulledUp <= 0) return;
				event.preventDefault();
				isPulling = true;
				rawPull = pulledUp;
				moveTowards(stretchFromPull(rawPull));
			},
			{ passive: false }
		);

		window.addEventListener('touchend', () => {
			if (touchStartY !== null && isPulling) release();
			touchStartY = null;
		});
	}

	const stretchLayer = document.querySelector<HTMLElement>('[data-bottom-stretch]');
	if (stretchLayer) startBottomStretch(stretchLayer);
</script>

<style>
	.bottom-stretch {
		position: fixed;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 0;
		height: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.stretch-stripes {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	.stripe-mint {
		fill: #9fd98f;
	}

	.stripe-blue {
		fill: rgb(86, 112, 236);
	}

	.stripe-yellow {
		fill: #f6d872;
	}

	.stripe-pink {
		fill: #ffc9e6;
	}

	.stripe-orange {
		fill: rgb(232, 110, 72);
	}
</style>

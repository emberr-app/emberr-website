---
interface Props {
	direction?: 'right' | 'down';
}

const { direction = 'right' } = Astro.props;
---

<svg
	class:list={['arrow-icon', `arrow-icon-${direction}`]}
	width="16"
	height="16"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	<path d="M5 12h14" />
	<path d="m12 5 7 7-7 7" />
</svg>

<style>
	.arrow-icon {
		flex-shrink: 0;
	}

	.arrow-icon-down {
		transform: rotate(90deg);
	}
</style>

---
import IconTile from './IconTile.astro';
import type { HighlightColorName, IconName } from './icons';
import TextLink from './TextLink.astro';

interface PrivacyPromise {
	text: string;
	icon: IconName;
	color: HighlightColorName;
}

const privacyPromises: PrivacyPromise[] = [
	{ text: 'Emberr has no accounts (yet), no analytics, no ads and no tracking.', icon: 'shield', color: 'green' },
	{
		text: 'Your notes, tasks, reminders, attachments and chats are stored only on your device.',
		icon: 'phone',
		color: 'blue'
	},
	{
		text: 'Nothing is sent to me (the developer) or to any server I run, except movie and show searches, which pass through a small proxy (see the privacy policy). I have no way to see your notes.',
		icon: 'eyeOff',
		color: 'purple'
	},
	{
		text: 'Emberr only connects to the internet for features you turn on or use, listed in the privacy policy.',
		icon: 'wifi',
		color: 'orange'
	},
	{
		text: 'AI features are disabled by default. Nothing related to AI is downloaded or sent until you turn them on.',
		icon: 'sparkle',
		color: 'yellow'
	}
];
---

<section id="privacy" class="page-width privacy" aria-labelledby="privacy-title">
	<div class="privacy-panel">
		<div class="privacy-intro">
			<h2 id="privacy-title" class="section-heading">
				<span class="heading-strong">Your notes stay yours.</span>
				<span class="heading-soft">No account, no tracking.</span>
			</h2>
			<p class="privacy-summary">Emberr works fully offline. This is the short version of the privacy policy.</p>
			<TextLink href="/privacy">Read the full privacy policy</TextLink>
		</div>
		<ul class="privacy-list">
			{
				privacyPromises.map((promise) => (
					<li class="privacy-item">
						<IconTile icon={promise.icon} color={promise.color} size="small" />
						<span>{promise.text}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.privacy {
		padding-block: 40px;
	}

	.privacy-panel {
		display: grid;
		grid-template-columns: 1fr;
		gap: 32px;
		padding: 32px 20px;
		border-radius: 24px;
		background-color: var(--color-card);
	}

	.privacy-summary {
		margin: 20px 0 8px;
		color: var(--color-text-secondary);
	}

	.privacy-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.privacy-item {
		display: flex;
		align-items: flex-start;
		gap: 16px;
		padding-block: 16px;
		border-bottom: 1px solid color-mix(in srgb, var(--color-text) 14%, transparent);
	}

	.privacy-item:first-child {
		padding-top: 0;
	}

	.privacy-item:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	@media (min-width: 960px) {
		.privacy {
			padding-block: 80px;
		}

		.privacy-panel {
			grid-template-columns: 0.9fr 1.1fr;
			gap: 76px;
			padding: 64px;
		}
	}
</style>

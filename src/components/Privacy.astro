---
import TextLink from './TextLink.astro';

const privacyPromises: string[] = [
	'Emberr has no accounts (yet), no analytics, no ads and no tracking.',
	'Your notes, tasks, reminders, attachments and chats are stored only on your device.',
	'Nothing is sent to me (the developer) or to any server I run, except movie and show searches, which pass through a small proxy (see the privacy policy). I have no way to see your notes.',
	'Emberr only connects to the internet for features you turn on or use, listed in the privacy policy.',
	'AI features are disabled by default. Nothing related to AI is downloaded or sent until you turn them on.'
];
---

<section id="privacy" class="page-width privacy" aria-labelledby="privacy-title">
	<div class="glass-strong privacy-panel">
		<div class="privacy-intro">
			<h2 id="privacy-title" class="section-heading">
				<span class="heading-strong">Your notes stay yours.</span>
				<span class="heading-soft">No account, no tracking.</span>
			</h2>
			<p class="privacy-summary">Emberr works fully offline. This is the short version of the privacy policy.</p>
			<TextLink href="/privacy">Read the full privacy policy</TextLink>
		</div>
		<ul class="privacy-list">
			{privacyPromises.map((promise) => <li class="privacy-item">{promise}</li>)}
		</ul>
	</div>
</section>

<style>
	.privacy {
		padding-block: 40px;
	}

	.privacy-panel {
		display: grid;
		grid-template-columns: 1fr;
		gap: 32px;
		padding: 32px 22px;
		border-radius: 24px;
	}

	.privacy-summary {
		margin: 20px 0 8px;
		color: var(--color-text-muted);
		line-height: 1.65;
	}

	.privacy-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.privacy-item {
		padding-block: 16px;
		border-bottom: 1px solid var(--color-border);
		color: var(--color-text-muted);
		line-height: 1.6;
	}

	.privacy-item:first-child {
		padding-top: 0;
	}

	.privacy-item:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	@media (min-width: 960px) {
		.privacy {
			padding-block: 80px;
		}

		.privacy-panel {
			grid-template-columns: 0.9fr 1.1fr;
			gap: 64px;
			padding: 56px;
			border-radius: 32px;
		}

		.privacy-summary {
			font-size: 1.0625rem;
		}
	}
</style>

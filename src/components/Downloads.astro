---
import DownloadCards from './DownloadCards';
import TextLink from './TextLink.astro';
import { siteLinks } from '../siteLinks';
---

<section id="download" class="page-width downloads" aria-labelledby="download-title">
	<h2 id="download-title" class="section-heading">
		<span class="heading-strong">Try Emberr.</span>
		<span class="heading-soft">On Android, Linux and Windows.</span>
	</h2>
	<p class="downloads-summary">
		Emberr is in beta. It's free and open source, so expect some rough edges and tell us what could be better.
		On Linux and Windows, Emberr updates itself from inside the app.
	</p>
	<DownloadCards client:idle />
	<div class="downloads-links">
		<TextLink href={siteLinks.releases}>All releases on GitHub</TextLink>
		<TextLink href={siteLinks.buildFromSource}>Build from source</TextLink>
	</div>
</section>

<style>
	.downloads {
		padding-block: 80px;
	}

	.downloads-summary {
		max-width: 32rem;
		margin-top: 20px;
		color: var(--color-text-secondary);
	}

	.downloads-links {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 28px;
		margin-top: 24px;
	}

	@media (min-width: 960px) {
		.downloads {
			padding-block: 120px;
		}
	}
</style>

---
import { Image } from 'astro:assets';
import emberrGhost from '../assets/emberr-ghost.png';
import ButtonLink from './ButtonLink.astro';
import { outlineIconMarkup } from './icons';
import { siteLinks } from '../siteLinks';
---

<header class="site-header">
	<div class="page-width header-bar">
		<a class="brand" href="/">
			<Image src={emberrGhost} alt="" width={30} height={29} loading="eager" />
			<span class="brand-name">Emberr</span>
		</a>
		<div class="header-end">
			<nav class="site-nav" aria-label="Main">
				<a class="nav-link" href="/#features">Features</a>
				<a class="nav-link" href="/#privacy">Privacy</a>
				<a class="nav-link" href="/#faq">FAQ</a>
				<a class="nav-link" href={siteLinks.github}>GitHub</a>
			</nav>
			<button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" data-theme-toggle>
				<svg class="theme-toggle-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={outlineIconMarkup('moon')} />
				<svg class="theme-toggle-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={outlineIconMarkup('sun')} />
			</button>
			<ButtonLink href="/#download" size="small">Download</ButtonLink>
		</div>
	</div>
</header>

<script>
	import { browserBarColorByTheme, themeStorageKey, type Theme } from '../theme';

	function currentTheme(): Theme {
		return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
	}

	function updateTogglePressedState(themeToggle: HTMLButtonElement) {
		themeToggle.setAttribute('aria-pressed', String(currentTheme() === 'dark'));
	}

	function applyTheme(theme: Theme) {
		document.documentElement.dataset.theme = theme;
		document.querySelector('meta[name="theme-color"]')?.setAttribute('content', browserBarColorByTheme[theme]);
		try {
			localStorage.setItem(themeStorageKey, theme);
		} catch {}
	}

	const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	if (themeToggle) {
		updateTogglePressedState(themeToggle);
		themeToggle.addEventListener('click', () => {
			applyTheme(currentTheme() === 'dark' ? 'light' : 'dark');
			updateTogglePressedState(themeToggle);
		});
	}
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid var(--color-border);
		background-color: var(--color-header-background);
		-webkit-backdrop-filter: blur(20px) saturate(1.6);
		backdrop-filter: blur(20px) saturate(1.6);
	}

	.header-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		height: var(--header-height);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
	}

	.brand :global(img) {
		filter: invert(1);
		animation: ghost-float 4s ease-in-out infinite;
	}

	@keyframes ghost-float {
		0%,
		100% {
			transform: translateY(0) rotate(0deg);
		}

		25% {
			transform: translateY(-2px) rotate(-3deg);
		}

		50% {
			transform: translateY(-3px) rotate(0deg);
		}

		75% {
			transform: translateY(-2px) rotate(3deg);
		}
	}

	:global(:root[data-theme='dark']) .brand :global(img) {
		filter: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.brand :global(img) {
			animation: none;
		}
	}

	.theme-toggle {
		display: inline-grid;
		place-items: center;
		width: 38px;
		height: 38px;
		padding: 0;
		border: none;
		border-radius: 8px;
		background-color: transparent;
		color: var(--color-text);
		cursor: pointer;
		transition: background-color 200ms ease;
	}

	.theme-toggle:hover {
		background-color: var(--color-card);
	}

	.theme-toggle svg {
		width: 20px;
		height: 20px;
	}

	.theme-toggle-sun,
	:global(:root[data-theme='dark']) .theme-toggle-moon {
		display: none;
	}

	:global(:root[data-theme='dark']) .theme-toggle-sun {
		display: block;
	}

	.brand-name {
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.header-end {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.site-nav {
		display: none;
	}

	.nav-link {
		padding: 8px 12px;
		color: var(--color-text-secondary);
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		letter-spacing: -0.005em;
		text-decoration: none;
		transition: color 200ms ease;
	}

	.nav-link:hover {
		color: var(--color-text);
		text-decoration: underline;
		text-underline-offset: 5px;
	}

	@media (min-width: 768px) {
		.site-nav {
			display: flex;
			align-items: center;
			margin-right: 8px;
		}
	}
</style>

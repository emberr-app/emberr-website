---
import { Image } from 'astro:assets';
import emberrIcon from '../assets/emberr-icon.png';
import ButtonLink from './ButtonLink.astro';
---

<header class="site-header">
	<div class="header-backdrop" aria-hidden="true"></div>
	<div class="header-bar">
		<a class="glass brand" href="/">
			<Image src={emberrIcon} alt="" width={26} height={26} loading="eager" />
			<span>Emberr</span>
		</a>
		<nav class="glass site-nav" aria-label="Main">
			<a class="nav-link" href="/#features">Features</a>
			<a class="nav-link" href="/#privacy">Privacy</a>
			<a class="nav-link" href="https://github.com/emberr-app/Emberr">GitHub</a>
		</nav>
		<ButtonLink href="/#download" size="small">Download</ButtonLink>
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		inset: 0 0 auto;
		z-index: 50;
	}

	.header-backdrop {
		position: absolute;
		inset: 0 0 auto;
		height: 7rem;
		pointer-events: none;
		-webkit-backdrop-filter: blur(20px);
		backdrop-filter: blur(20px);
		-webkit-mask-image: linear-gradient(180deg, #000000 0%, rgba(0, 0, 0, 0.9) 38%, transparent);
		mask-image: linear-gradient(180deg, #000000 0%, rgba(0, 0, 0, 0.9) 38%, transparent);
	}

	.header-bar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		height: 80px;
		padding-inline: var(--page-gutter);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		height: 48px;
		padding: 0 18px 0 12px;
		border-radius: 9999px;
		font-size: 1.0625rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	.brand :global(img) {
		border-radius: 7px;
	}

	.site-nav {
		display: none;
	}

	.nav-link {
		padding: 8px 14px;
		border-radius: 9999px;
		color: var(--color-text-muted);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		transition: color 200ms ease;
	}

	.nav-link:hover {
		color: var(--color-text);
	}

	@media (min-width: 768px) {
		.site-nav {
			position: absolute;
			top: 50%;
			left: 50%;
			display: flex;
			align-items: center;
			gap: 2px;
			height: 48px;
			padding-inline: 6px;
			border-radius: 9999px;
			transform: translate(-50%, -50%);
		}
	}
</style>

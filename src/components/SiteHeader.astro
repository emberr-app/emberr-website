---
import { Image } from 'astro:assets';
import emberrIcon from '../assets/emberr-icon.png';
import ButtonLink from './ButtonLink.astro';
---

<header class="site-header">
	<div class="page-width site-header-inner">
		<a class="brand" href="/">
			<Image src={emberrIcon} alt="" width={32} height={32} loading="eager" />
			<span>Emberr</span>
		</a>
		<nav class="site-nav" aria-label="Main">
			<a class="nav-link" href="/#features">Features</a>
			<a class="nav-link" href="/#privacy">Privacy</a>
			<a class="nav-link" href="https://github.com/emberr-app/Emberr/releases">Releases</a>
		</nav>
		<div class="header-actions">
			<a class="github-link" href="https://github.com/emberr-app/Emberr" aria-label="Emberr on GitHub" title="Source code on GitHub">
				<svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
					<path
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
			<ButtonLink href="/#download" size="small">Download</ButtonLink>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background-color: var(--color-background);
		border-bottom: 1px solid var(--color-border-soft);
	}

	.site-header-inner {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 16px;
		height: 72px;
	}

	.brand {
		justify-self: start;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: 1.125rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	.brand :global(img) {
		border-radius: 8px;
	}

	.site-nav {
		display: none;
	}

	.nav-link {
		padding: 6px 12px;
		border-radius: 999px;
		color: var(--color-text-muted);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		transition:
			color 150ms ease,
			background-color 150ms ease;
	}

	.nav-link:hover {
		color: var(--color-text);
		background-color: var(--color-surface);
	}

	.header-actions {
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.github-link {
		display: none;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 999px;
		color: var(--color-text-muted);
		transition:
			color 150ms ease,
			background-color 150ms ease;
	}

	.github-link:hover {
		color: var(--color-text);
		background-color: var(--color-surface);
	}

	@media (min-width: 768px) {
		.site-header-inner {
			grid-template-columns: 1fr auto 1fr;
			height: 84px;
		}

		.site-nav {
			display: flex;
			align-items: center;
			gap: 4px;
		}

		.github-link {
			display: inline-grid;
		}
	}
</style>

---
import { Image } from 'astro:assets';
import emberrGhost from '../assets/emberr-ghost.png';
import ButtonLink from './ButtonLink.astro';
---

<header class="site-header">
	<div class="header-bar">
		<a class="brand" href="/" aria-label="Emberr home">
			<Image src={emberrGhost} alt="" width={46} height={44} loading="eager" />
		</a>
		<nav class="frosted-bar site-nav" aria-label="Main">
			<a class="nav-link" href="/#features">Features</a>
			<a class="nav-link" href="/#privacy">Privacy</a>
			<a class="nav-link" href="https://github.com/emberr-app/Emberr">GitHub</a>
		</nav>
		<ButtonLink href="/#download" size="small">Download</ButtonLink>
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		inset: 0 0 auto;
		z-index: 50;
		pointer-events: none;
	}

	.header-bar > * {
		pointer-events: auto;
	}

	.header-bar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		height: 80px;
		padding-inline: var(--page-gutter);
	}

	@media (min-width: 1024px) {
		.header-bar {
			padding-inline: 48px;
		}
	}

	.brand {
		display: inline-grid;
		place-items: center;
		width: 56px;
		height: 56px;
		margin-top: 12px;
		border-radius: 9999px;
		transition: transform 300ms ease;
	}

	.brand:hover {
		transform: rotate(-8deg);
	}

	.brand :global(img) {
		filter: invert(1);
		animation: ghost-float 4s ease-in-out infinite;
	}

	@media (prefers-color-scheme: dark) {
		.brand :global(img) {
			filter: none;
		}
	}

	@keyframes ghost-float {
		0%,
		100% {
			transform: translateY(0) rotate(0deg);
		}

		25% {
			transform: translateY(-3px) rotate(-3deg);
		}

		50% {
			transform: translateY(-5px) rotate(0deg);
		}

		75% {
			transform: translateY(-3px) rotate(3deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brand :global(img) {
			animation: none;
		}
	}

	.site-nav {
		display: none;
	}

	.nav-link {
		padding: 8px 14px;
		border-radius: 9999px;
		color: color-mix(in srgb, var(--color-text) 75%, transparent);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		transition: color 200ms ease;
	}

	.nav-link:hover {
		color: var(--color-text);
	}

	@media (min-width: 768px) {
		.site-nav {
			position: absolute;
			top: 50%;
			left: 50%;
			display: flex;
			align-items: center;
			gap: 2px;
			height: 48px;
			padding-inline: 6px;
			border-radius: 9999px;
			transform: translate(-50%, -50%);
		}
	}
</style>

---
import ArrowIcon from './ArrowIcon.astro';

interface Props {
	href: string;
	arrow?: 'right' | 'down';
}

const { href, arrow = 'right' } = Astro.props;
---

<a class="text-link" href={href}>
	<slot />
	<ArrowIcon direction={arrow} />
</a>

<style>
	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		font-family: var(--font-sans);
		font-size: 0.9375rem;
		font-weight: 500;
		letter-spacing: -0.005em;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 5px;
	}
</style>

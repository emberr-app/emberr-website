---
import ArrowIcon from './ArrowIcon.astro';

interface Props {
	href: string;
	arrow?: 'right' | 'down';
}

const { href, arrow = 'right' } = Astro.props;
---

<a class="text-link" href={href}>
	<slot />
	<ArrowIcon direction={arrow} />
</a>

<style>
	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		min-height: 44px;
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 6px;
		transition: text-decoration-color 150ms ease;
	}

	.text-link:hover {
		text-decoration-color: currentColor;
	}
</style>

---
import ArrowIcon from './ArrowIcon.astro';

interface Props {
	href: string;
	arrow?: 'right' | 'down';
}

const { href, arrow = 'right' } = Astro.props;
---

<a class="text-link" href={href}>
	<slot />
	<ArrowIcon direction={arrow} />
</a>

<style>
	.text-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		font-size: 0.9375rem;
		text-decoration: underline;
		text-decoration-color: var(--color-border-strong);
		text-underline-offset: 5px;
		transition: text-decoration-color 250ms ease;
	}

	.text-link:hover {
		text-decoration-color: currentColor;
	}
</style>

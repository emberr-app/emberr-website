---
import BottomStretch from '../components/BottomStretch.astro';
import DitherBackground from '../components/DitherBackground.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { Content as PrivacyPolicy } from '../documents/privacy-policy.md';
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Privacy Policy · Emberr';
const pageDescription =
	'How Emberr handles your data: no accounts, no analytics, no ads and no tracking. Your notes, tasks and reminders are stored only on your device.';
---

<Layout title={pageTitle} description={pageDescription}>
	<DitherBackground />
	<SiteHeader />
	<main class="page-width policy-page">
		<article class="glass-strong policy">
			<PrivacyPolicy />
		</article>
	</main>
	<SiteFooter />
	<BottomStretch />
</Layout>

<style>
	.policy-page {
		padding-block: 104px 96px;
	}

	.policy {
		max-width: 52rem;
		margin-inline: auto;
		padding: 32px 22px;
		border-radius: 24px;
	}

	@media (min-width: 768px) {
		.policy {
			padding: 56px;
			border-radius: 32px;
		}
	}

	.policy :global(h1) {
		font-size: clamp(2rem, 6vw, 3rem);
		letter-spacing: -0.02em;
	}

	.policy :global(h2) {
		margin-top: 48px;
		font-size: 1.375rem;
	}

	.policy :global(p),
	.policy :global(ul),
	.policy :global(table) {
		margin-top: 16px;
	}

	.policy :global(p),
	.policy :global(li),
	.policy :global(td) {
		color: var(--color-text-muted);
	}

	.policy :global(ul) {
		padding-left: 1.25rem;
	}

	.policy :global(li + li) {
		margin-top: 8px;
	}

	.policy :global(strong),
	.policy :global(th) {
		color: var(--color-text);
	}

	.policy :global(code) {
		padding: 2px 6px;
		border-radius: 6px;
		background-color: var(--color-surface);
		font-size: 0.875em;
	}

	.policy :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.875rem;
	}

	.policy :global(th),
	.policy :global(td) {
		padding: 12px 8px;
		border-bottom: 1px solid var(--color-border);
		text-align: left;
		vertical-align: top;
	}

	.policy :global(th) {
		font-weight: 500;
	}
</style>

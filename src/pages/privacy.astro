---
import EdgeStretch from '../components/EdgeStretch.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { Content as PrivacyPolicy } from '../documents/privacy-policy.md';
import Layout from '../layouts/Layout.astro';

const pageTitle = 'Privacy Policy · Emberr';
const pageDescription =
	'How Emberr handles your data: no accounts, no analytics, no ads and no tracking. Your notes, tasks and reminders are stored only on your device.';
---

<Layout title={pageTitle} description={pageDescription}>
	<SiteHeader />
	<main class="page-width policy-page">
		<article class="policy">
			<PrivacyPolicy />
		</article>
	</main>
	<SiteFooter />
	<EdgeStretch />
</Layout>

<style>
	.policy-page {
		padding-block: 48px 80px;
	}

	.policy {
		max-width: 52rem;
		margin-inline: auto;
		padding: 32px 20px;
		border: 1px solid var(--color-border);
		border-radius: 24px;
		background-color: var(--color-card);
	}

	@media (min-width: 768px) {
		.policy-page {
			padding-block: 76px 120px;
		}

		.policy {
			padding: 64px;
		}
	}

	.policy :global(h1) {
		font-size: clamp(2.25rem, 6vw, 4.25rem);
	}

	.policy :global(h2) {
		margin-top: 48px;
		font-family: var(--font-sans);
		font-size: 1.5rem;
		font-weight: 500;
		line-height: 1.3;
	}

	.policy :global(p),
	.policy :global(ul),
	.policy :global(table) {
		margin-top: 16px;
	}

	.policy :global(p),
	.policy :global(li),
	.policy :global(td) {
		color: var(--color-text-secondary);
	}

	.policy :global(ul) {
		padding-left: 1.25rem;
	}

	.policy :global(li + li) {
		margin-top: 8px;
	}

	.policy :global(strong),
	.policy :global(th) {
		color: var(--color-text);
	}

	.policy :global(code) {
		padding: 2px 6px;
		border-radius: 6px;
		background-color: var(--color-oat);
		font-family: var(--font-mono);
		font-size: 0.8em;
	}

	.policy :global(table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 1rem;
	}

	.policy :global(th),
	.policy :global(td) {
		padding: 12px 8px;
		border-bottom: 1px solid var(--color-border);
		text-align: left;
		vertical-align: top;
	}

	.policy :global(th) {
		font-family: var(--font-sans);
		font-size: 0.875rem;
		font-weight: 500;
	}
</style>

---
import emberrIcon from '../assets/emberr-icon.png';
import screenshots from '../assets/screenshots.png';
import AppFacts from '../components/AppFacts.astro';
import BlockGallery from '../components/BlockGallery.astro';
import Downloads from '../components/Downloads.astro';
import EdgeStretch from '../components/EdgeStretch.astro';
import Faq from '../components/Faq.astro';
import FeatureTiles from '../components/FeatureTiles.astro';
import Hero from '../components/Hero.astro';
import Privacy from '../components/Privacy.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Layout from '../layouts/Layout.astro';
import { siteLinks } from '../siteLinks';

const pageTitle = 'Emberr: Private Workspace';
const pageDescription =
	'Emberr is a free, open-source, offline-first notes, calendar and reminder app for Android, Linux and Windows. Your data stays on your device.';

const softwareApplicationData = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Emberr',
	alternateName: pageTitle,
	description: pageDescription,
	url: new URL('/', Astro.site).href,
	applicationCategory: 'ProductivityApplication',
	operatingSystem: 'Android, Linux, Windows',
	isAccessibleForFree: true,
	license: 'https://www.gnu.org/licenses/agpl-3.0.html',
	image: new URL(emberrIcon.src, Astro.site).href,
	screenshot: new URL(screenshots.src, Astro.site).href,
	downloadUrl: siteLinks.releases,
	author: {
		'@type': 'Person',
		name: 'Benny',
		url: siteLinks.developerProfile
	},
	sameAs: [siteLinks.github, siteLinks.x, siteLinks.reddit]
};
---

<Layout title={pageTitle} description={pageDescription}>
	<script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(softwareApplicationData)} />
	<SiteHeader />
	<main>
		<Hero />
		<ProductShowcase />
		<AppFacts />
		<BlockGallery />
		<FeatureTiles />
		<Privacy />
		<Faq />
		<Downloads />
	</main>
	<SiteFooter />
	<EdgeStretch />
</Layout>
